@{
    var selectedOption = ViewBag.SelectedOption as string;
}

<div class="new-view">
    <h2>You selected: @selectedOption</h2>
    <p>Here are your loan offers for <strong>@selectedOption</strong>:</p>
    <ul>
        <li>Offer 1: $10,000 at 5.99% APR</li>
        <li>Offer 2: $15,000 at 6.49% APR</li>
        <li>Offer 3: $20,000 at 6.99% APR</li>
    </ul>
    <p>Please review the offers and select the one that best suits your needs.</p>
</div>